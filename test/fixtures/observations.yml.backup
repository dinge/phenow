# Testing observations by Jake
plant_1_smoke_test:
  plant: plant_1
  user: jake
  observed_at: <%= 2.days.ago %>
  stage: testing
  notes: >
    Initial smoke test after 3 days cure. Smooth inhale, fruity/gassy exhale.
    Strong euphoric onset, settles into deep relaxation. Excellent potency.
  conditions: {}
  created_at: <%= 2.days.ago %>
  updated_at: <%= 2.days.ago %>
