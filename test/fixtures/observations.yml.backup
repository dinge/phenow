# Observations for Plant #1 (Keeper)
plant_1_week_1:
  plant: plant_1
  user: marcus
  observed_at: <%= 83.days.ago %>
  stage: vegetative
  notes: Strong start, healthy green leaves. Good root development visible.
  conditions:
    temperature: 78
    humidity: 55
    light_hours: 18
  created_at: <%= 83.days.ago %>
  updated_at: <%= 83.days.ago %>

plant_1_week_3:
  plant: plant_1
