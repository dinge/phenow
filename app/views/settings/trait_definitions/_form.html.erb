<%= form_with model: trait_definition, url: trait_definition.persisted? ? settings_trait_definition_path(trait_definition) : settings_trait_category_trait_definitions_path(trait_definition.trait_category || @trait_category) do |f| %>
  <% if trait_definition.errors.any? %>
    <div class="flash-alert">
      <h3>Please fix the following errors:</h3>
      <ul>
        <% trait_definition.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: form_input_class(trait_definition, :name),
        required: true,
        placeholder: "e.g., Plant Height" %>
    <%= error_for trait_definition, :name %>
  </div>

  <div class="form-group">
    <%= f.label :trait_category_id, "Category", class: "form-label" %>
    <%= f.collection_select :trait_category_id,
        TraitCategory.ordered,
        :id, :name,
        { prompt: "Select a category" },
        class: form_input_class(trait_definition, :trait_category_id),
        required: true %>
    <%= error_for trait_definition, :trait_category_id %>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 2,
        class: form_input_class(trait_definition, :description),
        placeholder: "Describe what this trait measures..." %>
    <%= error_for trait_definition, :description %>
  </div>

  <div class="form-group">
    <%= f.label :data_type, class: "form-label" %>
    <%= f.select :data_type,
        TraitDefinition::DATA_TYPES.map { |t| [t.titleize, t] },
        { prompt: "Select data type" },
        class: form_input_class(trait_definition, :data_type),
        required: true %>
    <%= error_for trait_definition, :data_type %>
    <p class="form-hint">Numeric (measurements), Scale (1-10 ratings), Select (predefined options), Boolean (yes/no), Text (free-form)</p>
  </div>

  <div class="form-group">
    <%= f.label :unit, class: "form-label" %>
    <%= f.text_field :unit, class: form_input_class(trait_definition, :unit),
        placeholder: "e.g., cm, g, days" %>
    <%= error_for trait_definition, :unit %>
    <p class="form-hint">For numeric data types</p>
  </div>

  <div class="form-group">
    <%= f.label :min_value, class: "form-label" %>
    <%= f.number_field :min_value, class: form_input_class(trait_definition, :min_value),
        step: 0.01 %>
    <%= error_for trait_definition, :min_value %>
  </div>

  <div class="form-group">
    <%= f.label :max_value, class: "form-label" %>
    <%= f.number_field :max_value, class: form_input_class(trait_definition, :max_value),
        step: 0.01 %>
    <%= error_for trait_definition, :max_value %>
  </div>

  <div class="form-group">
    <%= f.label :display_order, class: "form-label" %>
    <%= f.number_field :display_order, class: form_input_class(trait_definition, :display_order),
        min: 0,
        value: trait_definition.display_order || 0 %>
    <%= error_for trait_definition, :display_order %>
    <p class="form-hint">Lower numbers appear first</p>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", settings_trait_categories_path, class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
