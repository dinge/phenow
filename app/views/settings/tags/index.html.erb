<div class="page-header">
  <h1 class="page-title">Tags</h1>
  <div class="page-actions">
    <%= link_to "New Tag", new_settings_tag_path, class: "btn-primary" %>
  </div>
</div>

<div class="card">
  <% if collection.any? %>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Color</th>
            <th>Tagged Items</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% collection.each do |tag| %>
            <%= render "row", tag: tag %>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <%= render "shared/empty_state",
        title: "No tags found",
        description: "Get started by creating your first tag.",
        action_path: new_settings_tag_path,
        action_text: "New Tag" %>
  <% end %>
</div>
