<%= form_with model: tag, url: tag.persisted? ? settings_tag_path(tag) : settings_tags_path do |f| %>
  <% if tag.errors.any? %>
    <div class="flash-alert">
      <h3>Please fix the following errors:</h3>
      <ul>
        <% tag.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: form_input_class(tag, :name),
        required: true,
        placeholder: "e.g., Keeper, High Terps, Frosty" %>
    <%= error_for tag, :name %>
  </div>

  <div class="form-group">
    <%= f.label :color, class: "form-label" %>
    <%= f.color_field :color, class: form_input_class(tag, :color),
        value: tag.color || "#10B981" %>
    <%= error_for tag, :color %>
    <p class="form-hint">Choose a color for this tag</p>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", settings_tags_path, class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
