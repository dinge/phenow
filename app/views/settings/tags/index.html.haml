.page-header
  %h1.page-title Tags
  .page-actions
    = link_to "New Tag", new_settings_tag_path, class: "btn-primary"

.card
  - if collection.any?
    = datagrid_table(@grid, collection, class: "data-table")
    = render "shared/pagination", pagy: @pagy
  - else
    = render "shared/empty_state",
      title: "No tags found",
      description: "Get started by creating your first tag.",
      action_path: new_settings_tag_path,
      action_text: "New Tag"
