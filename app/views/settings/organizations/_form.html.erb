<%= form_with model: organization, url: settings_organization_path do |f| %>
  <% if organization.errors.any? %>
    <div class="flash-alert">
      <h3>Please fix the following errors:</h3>
      <ul>
        <% organization.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: form_input_class(organization, :name),
        required: true,
        placeholder: "Organization name" %>
    <%= error_for organization, :name %>
  </div>

  <div class="form-group">
    <%= f.label :slug, class: "form-label" %>
    <%= f.text_field :slug, class: form_input_class(organization, :slug),
        required: true,
        placeholder: "organization-slug" %>
    <%= error_for organization, :slug %>
    <p class="form-hint">URL-friendly identifier (lowercase, hyphens only)</p>
  </div>

  <h2 class="section-heading">Organization Settings</h2>

  <div class="form-group">
    <%= label_tag "organization[settings][timezone]", "Timezone", class: "form-label" %>
    <%= text_field_tag "organization[settings][timezone]",
        organization.settings&.[]("timezone"),
        class: "form-input",
        placeholder: "America/Los_Angeles" %>
    <p class="form-hint">Default timezone for the organization</p>
  </div>

  <div class="form-group">
    <%= label_tag "organization[settings][default_flowering_schedule]", "Default Flowering Schedule", class: "form-label" %>
    <%= text_field_tag "organization[settings][default_flowering_schedule]",
        organization.settings&.[]("default_flowering_schedule"),
        class: "form-input",
        placeholder: "12/12" %>
    <p class="form-hint">Default light schedule (e.g., 12/12, 11/13)</p>
  </div>

  <div class="form-group">
    <%= label_tag "organization[settings][require_observation_photos]", "Require Observation Photos", class: "form-label" %>
    <%= check_box_tag "organization[settings][require_observation_photos]",
        "1",
        organization.settings&.[]("require_observation_photos"),
        class: "form-checkbox" %>
    <span class="form-hint">Require photos for all observations</span>
  </div>

  <div class="form-actions">
    <%= f.submit "Save Settings", class: "btn-primary" %>
  </div>
<% end %>
