<tr id="<%= dom_id(trait_category) %>">
  <td>
    <strong><%= trait_category.name %></strong>
  </td>
  <td><%= truncate(trait_category.description, length: 60) %></td>
  <td><%= trait_category.icon %></td>
  <td><%= trait_category.display_order %></td>
  <td><%= trait_category.trait_definitions.count %></td>
  <td>
    <% if trait_category.system_default? %>
      <span class="badge-info">System</span>
    <% else %>
      <span class="badge-success">Custom</span>
    <% end %>
  </td>
  <td class="table-actions">
    <% unless trait_category.system_default? %>
      <%= link_to "Edit", edit_settings_trait_category_path(trait_category), class: "btn-ghost btn-sm" %>
      <%= button_to "Delete", settings_trait_category_path(trait_category), method: :delete,
          class: "btn-ghost btn-sm btn-danger-ghost",
          form: { data: { turbo_confirm: "Delete this category? All custom trait definitions will also be deleted." } } %>
    <% end %>
  </td>
</tr>
