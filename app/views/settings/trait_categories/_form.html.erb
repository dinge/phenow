<%= form_with model: trait_category, url: trait_category.persisted? ? settings_trait_category_path(trait_category) : settings_trait_categories_path do |f| %>
  <% if trait_category.errors.any? %>
    <div class="flash-alert">
      <h3>Please fix the following errors:</h3>
      <ul>
        <% trait_category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: form_input_class(trait_category, :name),
        required: true,
        placeholder: "e.g., Vigor & Health" %>
    <%= error_for trait_category, :name %>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 3,
        class: form_input_class(trait_category, :description),
        placeholder: "Describe what traits belong in this category..." %>
    <%= error_for trait_category, :description %>
  </div>

  <div class="form-group">
    <%= f.label :icon, class: "form-label" %>
    <%= f.text_field :icon, class: form_input_class(trait_category, :icon),
        placeholder: "e.g., heart, flower, leaf" %>
    <%= error_for trait_category, :icon %>
    <p class="form-hint">Icon name for display (optional)</p>
  </div>

  <div class="form-group">
    <%= f.label :display_order, class: "form-label" %>
    <%= f.number_field :display_order, class: form_input_class(trait_category, :display_order),
        min: 0,
        value: trait_category.display_order || 0 %>
    <%= error_for trait_category, :display_order %>
    <p class="form-hint">Lower numbers appear first</p>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", settings_trait_categories_path, class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
