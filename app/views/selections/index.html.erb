<div class="page-header">
  <h1 class="page-title">Selections - <%= @plant.display_name %></h1>
  <div class="page-actions">
    <%= link_to "New Selection", new_team_project_plant_selection_path(@team, @project, @plant),
        class: "btn-primary",
        data: { turbo_frame: "modal" } %>
  </div>
</div>

<%# Filters %>
<%= render "filters" %>

<%# Table %>
<div class="card">
  <% if collection.any? %>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>Decision</th>
            <th>Reasoning</th>
            <th>Score</th>
            <th>Selected By</th>
            <th>Selected At</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% collection.each do |selection| %>
            <%= render "row", selection: selection %>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <%= render "shared/empty_state",
        title: "No selections yet",
        description: "Record your first keep/cull decision for this plant.",
        action_path: new_team_project_plant_selection_path(@team, @project, @plant),
        action_text: "Add Selection" %>
  <% end %>
</div>
