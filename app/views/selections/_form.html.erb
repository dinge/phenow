<%= form_with model: selection, url: selection.new_record? ? team_project_plant_selections_path(@team, @project, @plant) : selection_path(selection), class: "space-y-4" do |f| %>
  <% if selection.errors.any? %>
    <div class="flash-alert">
      <h3 class="font-medium">Please fix the following errors:</h3>
      <ul class="mt-2 list-disc list-inside">
        <% selection.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :decision, class: "form-label" %>
    <%= f.select :decision,
        Selection::DECISIONS.map { |d| [d.titleize.gsub("_", " "), d] },
        { prompt: "Select decision..." },
        class: form_input_class(selection, :decision),
        required: true %>
    <%= error_for selection, :decision %>
    <p class="form-hint">Keep/cull decision or breeding designation</p>
  </div>

  <div class="form-group">
    <%= f.label :reasoning, class: "form-label" %>
    <%= f.text_area :reasoning, rows: 4, class: form_input_class(selection, :reasoning), required: true %>
    <%= error_for selection, :reasoning %>
    <p class="form-hint">Why this decision? Standout traits? Concerns? Be specific.</p>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :score, "Overall Score (1-10)", class: "form-label" %>
      <%= f.number_field :score,
          min: 1,
          max: 10,
          step: 0.1,
          class: form_input_class(selection, :score),
          placeholder: "Optional" %>
      <%= error_for selection, :score %>
      <p class="form-hint">Subjective rating of this phenotype</p>
    </div>

    <div class="form-group">
      <%= f.label :selected_at, "Selection Date", class: "form-label" %>
      <%= f.datetime_local_field :selected_at,
          value: (selection.selected_at || Time.current).strftime("%Y-%m-%dT%H:%M"),
          class: form_input_class(selection, :selected_at),
          required: true %>
      <%= error_for selection, :selected_at %>
    </div>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", team_project_plant_selections_path(@team, @project, @plant), class: "btn-secondary" %>
    <%= f.submit selection.new_record? ? "Create Selection" : "Update Selection", class: "btn-primary" %>
  </div>
<% end %>
