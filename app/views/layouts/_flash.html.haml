- flash.each do |type, message|
  - next if message.blank?
  .flash{ class: type, data: { controller: "flash" } }
    .flex.items-start.justify-between
      .flex-1
        = message
      %button{ type: "button", class: "ml-4 flex-shrink-0 text-gray-400 hover:text-gray-600", data: { action: "click->flash#dismiss" } }
        %svg.h-5.w-5(fill="none" viewBox="0 0 24 24" stroke="currentColor")
          %path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")
