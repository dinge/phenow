%aside.sidebar.hidden.lg:block
  .h-full.overflow-y-auto.py-4
    - if @team.present?
      -# Team Context
      .px-4.mb-4
        %h3.text-xs.font-semibold.text-gray-500.uppercase.tracking-wider
          = @team.name

      %nav.space-y-1.px-2
        = sidebar_link "Overview", team_path(@team)
        = sidebar_link "Projects", team_projects_path(@team)
        = sidebar_link "Members", team_memberships_path(@team)
        = sidebar_link "Settings", edit_team_path(@team)

      - if @project.present?
        -# Project Context
        .px-4.mt-6.mb-4
          %h3.text-xs.font-semibold.text-gray-500.uppercase.tracking-wider
            = @project.name

        %nav.space-y-1.px-2
          = sidebar_link "Overview", team_project_path(@team, @project)
          = sidebar_link "Plants", team_project_plants_path(@team, @project)
          = sidebar_link "Goals", team_project_project_goals_path(@team, @project)
          = sidebar_link "Settings", edit_team_project_path(@team, @project)
