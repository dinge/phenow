<%
# Locals:
#   title: string - The modal title
#   &block - Content to render in modal body
%>

<%= turbo_frame_tag "modal" do %>
  <div class="modal-backdrop" data-controller="modal" data-action="click->modal#close">
    <div class="modal" data-action="click->modal#stopPropagation">
      <div class="modal-header">
        <h2 class="modal-title"><%= title %></h2>
        <button type="button" class="modal-close" data-action="click->modal#close" aria-label="Close">
          &times;
        </button>
      </div>

      <div class="modal-body">
        <%= yield %>
      </div>
    </div>
  </div>
<% end %>
