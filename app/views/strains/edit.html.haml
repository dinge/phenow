= turbo_frame_tag "modal" do
  .modal-backdrop{ data: { controller: "modal", action: "keydown.esc->modal#close click->modal#closeOnBackdrop" } }
    .modal{ data: { modal_target: "content" } }
      .modal-header
        %h2.modal-title Edit Strain
        = link_to "x", strains_path, class: "text-2xl text-gray-400 hover:text-gray-600"

      .modal-body
        = render "form", strain: @resource
