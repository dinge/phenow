<%= form_with url: strains_path, method: :get, class: "filter-bar",
    data: { controller: "filters", turbo_frame: "_top" } do |f| %>
  <div class="filter-grid">
    <div class="form-group">
      <%= f.label :q, "Search", class: "form-label" %>
      <%= f.text_field :q, value: params[:q], class: "form-input",
          placeholder: "Name, breeder, or description...",
          data: { action: "input->filters#submit" } %>
    </div>

    <div class="form-group">
      <%= f.label :strain_type, "Type", class: "form-label" %>
      <%= f.select :strain_type,
          Strain::STRAIN_TYPES.map { |t| [t.humanize, t] },
          { include_blank: "All types", selected: params[:strain_type] },
          class: "form-select",
          data: { action: "change->filters#submit" } %>
    </div>

    <div class="form-group">
      <%= f.label :genetics_type, "Genetics", class: "form-label" %>
      <%= f.select :genetics_type,
          Strain::GENETICS_TYPES.map { |t| [t.humanize, t] },
          { include_blank: "All genetics", selected: params[:genetics_type] },
          class: "form-select",
          data: { action: "change->filters#submit" } %>
    </div>
  </div>

  <div class="filter-actions">
    <%= link_to "Clear Filters", strains_path, class: "btn-secondary btn-sm" %>
  </div>
<% end %>
