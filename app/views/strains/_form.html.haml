= simple_form_for strain, html: { class: "space-y-4" } do |f|
  = f.error_notification

  = f.input :name, required: true, input_html: { placeholder: "e.g., OG Kush, Blue Dream", class: "form-input" }, wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

  = f.input :breeder, input_html: { placeholder: "e.g., DNA Genetics, Sensi Seeds", class: "form-input" }, wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    = f.input :strain_type, collection: Strain::STRAIN_TYPES.map { |t| [t.humanize, t] }, include_blank: "Select type...", wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }, input_html: { class: "form-select" }

    = f.input :genetics_type, collection: Strain::GENETICS_TYPES.map { |t| [t.humanize, t] }, include_blank: "Select genetics...", wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }, input_html: { class: "form-select" }

  = f.input :lineage_text, label: "Lineage", input_html: { placeholder: "e.g., Chemdawg x OG Kush", class: "form-input" }, hint: "Parent strains separated by 'x'", wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

  = f.input :description, as: :text, input_html: { rows: 4, placeholder: "Describe the strain's characteristics, effects, and notable features...", class: "form-input" }, wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    = f.input :flowering_time_min, label: "Min Flowering Days", as: :integer, input_html: { min: 0, placeholder: "e.g., 56", class: "form-input" }, wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

    = f.input :flowering_time_max, label: "Max Flowering Days", as: :integer, input_html: { min: 0, placeholder: "e.g., 63", class: "form-input" }, wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    = f.input :thc_min, label: "Min THC %", as: :decimal, input_html: { min: 0, max: 100, step: 0.1, placeholder: "e.g., 18.0", class: "form-input" }, wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

    = f.input :thc_max, label: "Max THC %", as: :decimal, input_html: { min: 0, max: 100, step: 0.1, placeholder: "e.g., 24.0", class: "form-input" }, wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    = f.input :cbd_min, label: "Min CBD %", as: :decimal, input_html: { min: 0, max: 100, step: 0.1, placeholder: "e.g., 0.1", class: "form-input" }, wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

    = f.input :cbd_max, label: "Max CBD %", as: :decimal, input_html: { min: 0, max: 100, step: 0.1, placeholder: "e.g., 1.0", class: "form-input" }, wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    = f.input :public, as: :boolean, label: "Public", hint: "Make this strain visible to other organizations", wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }, input_html: { class: "form-checkbox" }

    = f.input :verified, as: :boolean, label: "Verified", hint: "Mark as verified genetics", wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }, input_html: { class: "form-checkbox" }

  .flex.justify-end.gap-3.pt-4.border-t.border-gray-200
    = link_to "Cancel", strains_path, class: "btn-secondary"
    = f.submit class: "btn-primary"
