<tr id="<%= dom_id(strain) %>">
  <td>
    <%= link_to strain.name, edit_strain_path(strain),
        class: "text-green-600 hover:text-green-800 font-medium",
        data: { turbo_frame: "modal" } %>
    <% if strain.verified %>
      <span class="badge-success">Verified</span>
    <% end %>
  </td>
  <td><%= strain.breeder %></td>
  <td>
    <% if strain.strain_type.present? %>
      <span class="badge-info"><%= strain.strain_type.humanize %></span>
    <% end %>
  </td>
  <td>
    <% if strain.genetics_type.present? %>
      <span class="badge"><%= strain.genetics_type.humanize %></span>
    <% end %>
  </td>
  <td>
    <% if strain.flowering_time_min.present? || strain.flowering_time_max.present? %>
      <%= [strain.flowering_time_min, strain.flowering_time_max].compact.join("-") %> days
    <% else %>
      <span class="text-gray-400">—</span>
    <% end %>
  </td>
  <td>
    <% if strain.thc_min.present? || strain.thc_max.present? %>
      <%= [strain.thc_min, strain.thc_max].compact.join("-") %>%
    <% else %>
      <span class="text-gray-400">—</span>
    <% end %>
  </td>
  <td class="text-right">
    <%= link_to "Edit", edit_strain_path(strain),
        class: "btn-ghost btn-sm",
        data: { turbo_frame: "modal" } %>
    <%= button_to "Delete", strain_path(strain), method: :delete,
        class: "btn-ghost btn-sm text-red-600",
        form: { data: { turbo_confirm: "Are you sure you want to delete this strain?" } } %>
  </td>
</tr>
