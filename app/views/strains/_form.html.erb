<%= form_with model: strain, class: "space-y-4" do |f| %>
  <% if strain.errors.any? %>
    <div class="flash-alert">
      <h3 class="font-medium">Please fix the following errors:</h3>
      <ul class="mt-2 list-disc list-inside">
        <% strain.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: form_input_class(strain, :name),
        required: true, placeholder: "e.g., OG Kush, Blue Dream" %>
    <%= error_for strain, :name %>
  </div>

  <div class="form-group">
    <%= f.label :breeder, class: "form-label" %>
    <%= f.text_field :breeder, class: form_input_class(strain, :breeder),
        placeholder: "e.g., DNA Genetics, Sensi Seeds" %>
    <%= error_for strain, :breeder %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-group">
      <%= f.label :strain_type, "Strain Type", class: "form-label" %>
      <%= f.select :strain_type,
          Strain::STRAIN_TYPES.map { |t| [t.humanize, t] },
          { include_blank: "Select type..." },
          class: form_input_class(strain, :strain_type) %>
      <%= error_for strain, :strain_type %>
    </div>

    <div class="form-group">
      <%= f.label :genetics_type, "Genetics Type", class: "form-label" %>
      <%= f.select :genetics_type,
          Strain::GENETICS_TYPES.map { |t| [t.humanize, t] },
          { include_blank: "Select genetics..." },
          class: form_input_class(strain, :genetics_type) %>
      <%= error_for strain, :genetics_type %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :lineage_text, "Lineage", class: "form-label" %>
    <%= f.text_field :lineage_text, class: form_input_class(strain, :lineage_text),
        placeholder: "e.g., Chemdawg x OG Kush" %>
    <p class="form-hint">Parent strains separated by 'x'</p>
    <%= error_for strain, :lineage_text %>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 4, class: form_input_class(strain, :description),
        placeholder: "Describe the strain's characteristics, effects, and notable features..." %>
    <%= error_for strain, :description %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-group">
      <%= f.label :flowering_time_min, "Min Flowering Days", class: "form-label" %>
      <%= f.number_field :flowering_time_min, class: form_input_class(strain, :flowering_time_min),
          min: 0, placeholder: "e.g., 56" %>
      <%= error_for strain, :flowering_time_min %>
    </div>

    <div class="form-group">
      <%= f.label :flowering_time_max, "Max Flowering Days", class: "form-label" %>
      <%= f.number_field :flowering_time_max, class: form_input_class(strain, :flowering_time_max),
          min: 0, placeholder: "e.g., 63" %>
      <%= error_for strain, :flowering_time_max %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-group">
      <%= f.label :thc_min, "Min THC %", class: "form-label" %>
      <%= f.number_field :thc_min, class: form_input_class(strain, :thc_min),
          min: 0, max: 100, step: 0.1, placeholder: "e.g., 18.0" %>
      <%= error_for strain, :thc_min %>
    </div>

    <div class="form-group">
      <%= f.label :thc_max, "Max THC %", class: "form-label" %>
      <%= f.number_field :thc_max, class: form_input_class(strain, :thc_max),
          min: 0, max: 100, step: 0.1, placeholder: "e.g., 24.0" %>
      <%= error_for strain, :thc_max %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-group">
      <%= f.label :cbd_min, "Min CBD %", class: "form-label" %>
      <%= f.number_field :cbd_min, class: form_input_class(strain, :cbd_min),
          min: 0, max: 100, step: 0.1, placeholder: "e.g., 0.1" %>
      <%= error_for strain, :cbd_min %>
    </div>

    <div class="form-group">
      <%= f.label :cbd_max, "Max CBD %", class: "form-label" %>
      <%= f.number_field :cbd_max, class: form_input_class(strain, :cbd_max),
          min: 0, max: 100, step: 0.1, placeholder: "e.g., 1.0" %>
      <%= error_for strain, :cbd_max %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-group">
      <label class="flex items-center gap-2">
        <%= f.check_box :public, class: "form-checkbox" %>
        <span class="form-label mb-0">Public</span>
      </label>
      <p class="form-hint">Make this strain visible to other organizations</p>
    </div>

    <div class="form-group">
      <label class="flex items-center gap-2">
        <%= f.check_box :verified, class: "form-checkbox" %>
        <span class="form-label mb-0">Verified</span>
      </label>
      <p class="form-hint">Mark as verified genetics</p>
    </div>
  </div>

  <div class="flex justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancel", strains_path, class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
