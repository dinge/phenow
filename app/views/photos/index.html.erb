<div class="page-header">
  <h1 class="page-title">Photos - <%= @plant.display_name %></h1>
  <div class="page-actions">
    <%= link_to "Upload Photo", new_team_project_plant_photo_path(@team, @project, @plant),
        class: "btn-primary",
        data: { turbo_frame: "modal" } %>
  </div>
</div>

<%# Filters %>
<div class="filters-bar">
  <%= form_with url: team_project_plant_photos_path(@team, @project, @plant), method: :get, class: "filters-form" do |f| %>
    <div class="filter-group">
      <%= f.label :photo_type, "Type", class: "filter-label" %>
      <%= f.select :photo_type,
          options_for_select(
            [["All Types", ""]] + Photo::PHOTO_TYPES.map { |t| [t.titleize, t] },
            params[:photo_type]
          ),
          {},
          class: "form-input",
          onchange: "this.form.requestSubmit()" %>
    </div>

    <div class="filter-group">
      <%= f.label :stage, "Stage", class: "filter-label" %>
      <%= f.select :stage,
          options_for_select(
            [["All Stages", ""]] + Plant::STAGES.map { |s| [s.titleize.gsub("_", " "), s] },
            params[:stage]
          ),
          {},
          class: "form-input",
          onchange: "this.form.requestSubmit()" %>
    </div>

    <% if params[:photo_type].present? || params[:stage].present? %>
      <%= link_to "Clear Filters", team_project_plant_photos_path(@team, @project, @plant), class: "btn-secondary" %>
    <% end %>
  <% end %>
</div>

<%# Photo Grid %>
<div class="card">
  <% if collection.any? %>
    <div class="photo-grid">
      <% collection.each do |photo| %>
        <%= render "card", photo: photo %>
      <% end %>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <%= render "shared/empty_state",
        title: "No photos yet",
        description: "Start documenting this plant by uploading your first photo.",
        action_path: new_team_project_plant_photo_path(@team, @project, @plant),
        action_text: "Upload Photo" %>
  <% end %>
</div>
