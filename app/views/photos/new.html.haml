= turbo_frame_tag "modal" do
  .modal-backdrop{ data: { controller: "modal", action: "keydown.esc->modal#close click->modal#closeOnBackdrop" } }
    .modal{ data: { modal_target: "content" } }
      .modal-header
        %h2.modal-title New Photo
        = link_to "x", team_project_plant_photos_path(@team, @project, @plant), class: "modal-close"

      .modal-body
        = render "form", photo: @resource
