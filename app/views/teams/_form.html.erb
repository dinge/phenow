<%= form_with model: team, class: "space-y-4" do |f| %>
  <% if team.errors.any? %>
    <div class="flash-alert">
      <h3 class="font-medium">Please fix the following errors:</h3>
      <ul class="mt-2 list-disc list-inside">
        <% team.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: form_input_class(team, :name),
        required: true,
        placeholder: "e.g., Breeding Team" %>
    <%= error_for team, :name %>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 4,
        class: form_input_class(team, :description),
        placeholder: "Describe the team's purpose and responsibilities..." %>
    <%= error_for team, :description %>
    <p class="form-hint">Optional. Help team members understand this team's role.</p>
  </div>

  <div class="flex justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancel", teams_path, class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
