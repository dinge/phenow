= simple_form_for team, html: { class: "space-y-4" } do |f|
  = f.error_notification

  = f.input :name, required: true, input_html: { placeholder: "e.g., Breeding Team", class: "form-input" }, wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

  = f.input :description, as: :text, input_html: { rows: 4, placeholder: "Describe the team's purpose and responsibilities...", class: "form-input" }, hint: "Optional. Help team members understand this team's role.", wrapper_html: { class: "form-group" }, label_html: { class: "form-label" }

  .flex.justify-end.gap-3.pt-4.border-t.border-gray-200
    = link_to "Cancel", teams_path, class: "btn-secondary"
    = f.submit class: "btn-primary"
