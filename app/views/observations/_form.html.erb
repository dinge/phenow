<%= form_with model: observation, url: observation.new_record? ? team_project_plant_observations_path(plant.team, plant.project, plant) : observation_path(observation), class: "observation-form" do |f| %>
  <% if observation.errors.any? %>
    <div class="flash-alert">
      <h3 class="alert-title">Please fix the following errors:</h3>
      <ul class="error-list">
        <% observation.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="form-group">
      <%= f.label :observed_at, "Date & Time", class: "form-label" %>
      <%= f.datetime_local_field :observed_at,
          class: form_input_class(observation, :observed_at),
          value: observation.observed_at&.strftime("%Y-%m-%dT%H:%M"),
          required: true %>
      <%= error_for observation, :observed_at %>
    </div>

    <div class="form-group">
      <%= f.label :stage, "Growth Stage", class: "form-label" %>
      <%= f.select :stage,
          Plant::STAGES.map { |s| [s.titleize.gsub("_", " "), s] },
          { selected: observation.stage || plant.current_stage },
          class: form_input_class(observation, :stage) %>
      <%= error_for observation, :stage %>
      <p class="form-hint">Current stage: <%= plant.current_stage.titleize.gsub("_", " ") %></p>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :overall_score, "Overall Score (1-10)", class: "form-label" %>
    <%= f.number_field :overall_score,
        min: 1,
        max: 10,
        step: 0.1,
        class: form_input_class(observation, :overall_score) %>
    <%= error_for observation, :overall_score %>
    <p class="form-hint">Rate this plant's overall performance (optional)</p>
  </div>

  <div class="form-group">
    <%= f.label :week_number, "Week Number", class: "form-label" %>
    <%= f.number_field :week_number,
        min: 0,
        class: form_input_class(observation, :week_number) %>
    <%= error_for observation, :week_number %>
    <p class="form-hint">Week of this stage (optional)</p>
  </div>

  <div class="form-group">
    <%= f.label :notes, "Observation Notes", class: "form-label" %>
    <%= f.text_area :notes,
        rows: 6,
        class: form_input_class(observation, :notes),
        placeholder: "Describe what you're seeing: structure, health, terpenes, frost development...\n\nInclude environmental conditions: Temp, RH, light schedule\nPrivate notes and observations" %>
    <%= error_for observation, :notes %>
    <p class="form-hint">All notes including environment conditions and personal observations</p>
  </div>

  <div class="form-actions">
    <%= link_to "Cancel", team_project_plant_observations_path(plant.team, plant.project, plant), class: "btn-secondary" %>
    <%= f.submit observation.new_record? ? "Create Observation" : "Update Observation", class: "btn-primary" %>
  </div>
<% end %>
