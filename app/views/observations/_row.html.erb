<tr id="<%= dom_id(observation) %>">
  <td><%= observation.display_date %></td>
  <td><%= stage_badge(observation.stage) %></td>
  <td>
    <% if observation.overall_score.present? %>
      <span class="score-badge"><%= observation.overall_score %>/10</span>
    <% else %>
      <span class="text-muted">-</span>
    <% end %>
  </td>
  <td class="notes-cell"><%= truncate(observation.notes, length: 80) %></td>
  <td><%= observation.observed_by.name %></td>
  <td>
    <div class="action-menu">
      <%= link_to "Edit", edit_observation_path(observation),
          class: "action-link",
          data: { turbo_frame: "modal" } %>
      <%= link_to "Delete", observation_path(observation),
          class: "action-link action-link-danger",
          data: {
            turbo_method: :delete,
            turbo_confirm: "Are you sure you want to delete this observation?"
          } %>
    </div>
  </td>
</tr>
