<%= form_with url: team_projects_path(@team), method: :get, class: "filter-bar",
    data: { controller: "filters", turbo_frame: "_top" } do |f| %>
  <div class="filter-grid">
    <div class="form-group">
      <%= f.label :q, "Search", class: "form-label" %>
      <%= f.text_field :q, value: params[:q], class: "form-input",
          placeholder: "Search projects...",
          data: { action: "input->filters#submit" } %>
    </div>

    <div class="form-group">
      <%= f.label :project_type, "Type", class: "form-label" %>
      <%= f.select :project_type,
          Project::PROJECT_TYPES.map { |t| [t.humanize, t] },
          { include_blank: "All types" },
          class: "form-select",
          data: { action: "change->filters#submit" } %>
    </div>

    <div class="form-group">
      <%= f.label :status, "Status", class: "form-label" %>
      <%= f.select :status,
          Project::STATUSES.map { |s| [s.humanize, s] },
          { include_blank: "All statuses" },
          class: "form-select",
          data: { action: "change->filters#submit" } %>
    </div>
  </div>

  <div class="filter-actions">
    <%= link_to "Clear", team_projects_path(@team), class: "btn-secondary" %>
  </div>
<% end %>
