= simple_form_for project, url: project.persisted? ? team_project_path(@team, project) : team_projects_path(@team), html: { class: "space-y-4" } do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  .form-group
    = f.input :name, label: "Name", input_html: { class: "form-input" }, required: true, hint: false

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    .form-group
      = f.input :project_type, collection: Project::PROJECT_TYPES.map { |t| [t.humanize, t] }, prompt: "Select type...", input_html: { class: "form-select" }, required: true, hint: false

    .form-group
      = f.input :status, collection: Project::STATUSES.map { |s| [s.humanize, s] }, prompt: "Select status...", input_html: { class: "form-select" }, required: true, hint: false

  .form-group
    = f.association :strain, collection: @team.organization.strains.order(:name), label_method: :name, value_method: :id, prompt: "Select strain...", input_html: { class: "form-select" }, label: "Strain (optional)", hint: "Select the primary strain for this project"

  .form-group
    = f.input :description, as: :text, input_html: { rows: 4, class: "form-textarea", placeholder: "Describe the goals and focus of this project..." }, hint: false

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    .form-group
      = f.input :start_date, as: :date, input_html: { class: "form-input" }, hint: false

    .form-group
      = f.input :target_end_date, as: :date, input_html: { class: "form-input" }, hint: false

  .form-group
    = f.input :seed_count, label: "Expected seed/clone count", input_html: { class: "form-input", min: 0 }, hint: "How many seeds or clones do you plan to pop/run?"

  .flex.justify-end.gap-3.pt-4.border-t.border-gray-200
    = link_to "Cancel", team_projects_path(@team), class: "btn-secondary"
    = f.submit class: "btn-primary"
