<%= form_with model: plant, url: plant.new_record? ? team_project_plants_path(@team, @project) : team_project_plant_path(@team, @project, plant), class: "space-y-4" do |f| %>
  <% if plant.errors.any? %>
    <div class="flash-alert">
      <h3 class="font-medium">Please fix the following errors:</h3>
      <ul class="mt-2 list-disc list-inside">
        <% plant.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-group">
      <%= f.label :identifier, class: "form-label" %>
      <%= f.text_field :identifier, class: form_input_class(plant, :identifier), required: true %>
      <%= error_for plant, :identifier %>
      <p class="form-hint">Unique identifier for this plant (e.g., #1, A-12, PP-3)</p>
    </div>

    <div class="form-group">
      <%= f.label :name, "Name (optional)", class: "form-label" %>
      <%= f.text_field :name, class: form_input_class(plant, :name) %>
      <%= error_for plant, :name %>
      <p class="form-hint">Friendly name if keeping as mother/father</p>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :strain_id, "Strain", class: "form-label" %>
    <%= f.select :strain_id,
        @project.team.organization.strains.order(:name).map { |s| [s.name, s.id] },
        { include_blank: "Select strain..." },
        class: form_input_class(plant, :strain_id) %>
    <%= error_for plant, :strain_id %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-group">
      <%= f.label :source_type, "Source Type", class: "form-label" %>
      <%= f.select :source_type,
          Plant::SOURCE_TYPES.map { |t| [t.titleize, t] },
          {},
          class: form_input_class(plant, :source_type),
          required: true %>
      <%= error_for plant, :source_type %>
    </div>

    <div class="form-group">
      <%= f.label :sex, class: "form-label" %>
      <%= f.select :sex,
          Plant::SEXES.map { |s| [s.titleize, s] },
          {},
          class: form_input_class(plant, :sex) %>
      <%= error_for plant, :sex %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-group">
      <%= f.label :current_stage, "Current Stage", class: "form-label" %>
      <%= f.select :current_stage,
          Plant::STAGES.map { |s| [s.titleize.gsub("_", " "), s] },
          {},
          class: form_input_class(plant, :current_stage) %>
      <%= error_for plant, :current_stage %>
    </div>

    <div class="form-group">
      <%= f.label :status, class: "form-label" %>
      <%= f.select :status,
          Plant::STATUSES.map { |s| [s.titleize, s] },
          {},
          class: form_input_class(plant, :status) %>
      <%= error_for plant, :status %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="form-group">
      <%= f.label :germination_date, class: "form-label" %>
      <%= f.date_field :germination_date, class: form_input_class(plant, :germination_date) %>
      <%= error_for plant, :germination_date %>
    </div>

    <div class="form-group">
      <%= f.label :flip_date, "Flip to Flower Date", class: "form-label" %>
      <%= f.date_field :flip_date, class: form_input_class(plant, :flip_date) %>
      <%= error_for plant, :flip_date %>
    </div>

    <div class="form-group">
      <%= f.label :harvest_date, class: "form-label" %>
      <%= f.date_field :harvest_date, class: form_input_class(plant, :harvest_date) %>
      <%= error_for plant, :harvest_date %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_area :notes, rows: 4, class: form_input_class(plant, :notes) %>
    <%= error_for plant, :notes %>
    <p class="form-hint">Observations, characteristics, or any important notes</p>
  </div>

  <div class="flex justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to "Cancel", team_project_plants_path(@team, @project), class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
