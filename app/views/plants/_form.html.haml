= simple_form_for plant, url: plant.new_record? ? team_project_plants_path(@team, @project) : team_project_plant_path(@team, @project, plant), html: { class: "space-y-4" } do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    .form-group
      = f.input :identifier, label: "Identifier", input_html: { class: "form-input" }, required: true, hint: "Unique identifier for this plant (e.g., #1, A-12, PP-3)"

    .form-group
      = f.input :name, label: "Name (optional)", input_html: { class: "form-input" }, hint: "Friendly name if keeping as mother/father"

  .form-group
    = f.association :strain, collection: @project.team.organization.strains.order(:name), label_method: :name, value_method: :id, prompt: "Select strain...", input_html: { class: "form-select" }, label: "Strain", hint: false

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    .form-group
      = f.input :source_type, collection: Plant::SOURCE_TYPES.map { |t| [t.titleize, t] }, input_html: { class: "form-select" }, label: "Source Type", required: true, hint: false

    .form-group
      = f.input :sex, collection: Plant::SEXES.map { |s| [s.titleize, s] }, input_html: { class: "form-select" }, hint: false

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    .form-group
      = f.input :current_stage, collection: Plant::STAGES.map { |s| [s.titleize.gsub("_", " "), s] }, input_html: { class: "form-select" }, label: "Current Stage", hint: false

    .form-group
      = f.input :status, collection: Plant::STATUSES.map { |s| [s.titleize, s] }, input_html: { class: "form-select" }, hint: false

  .grid.grid-cols-1.sm:grid-cols-3.gap-4
    .form-group
      = f.input :germination_date, as: :date, input_html: { class: "form-input" }, hint: false

    .form-group
      = f.input :flip_date, label: "Flip to Flower Date", as: :date, input_html: { class: "form-input" }, hint: false

    .form-group
      = f.input :harvest_date, as: :date, input_html: { class: "form-input" }, hint: false

  .form-group
    = f.input :notes, as: :text, input_html: { rows: 4, class: "form-textarea" }, hint: "Observations, characteristics, or any important notes"

  .flex.justify-end.gap-3.pt-4.border-t.border-gray-200
    = link_to "Cancel", team_project_plants_path(@team, @project), class: "btn-secondary"
    = f.submit class: "btn-primary"
