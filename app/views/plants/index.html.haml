.page-header
  %h1.page-title
    Plants -
    = @project.name
  .page-actions
    = link_to "New Plant", new_team_project_plant_path(@team, @project), class: "btn-primary", data: { turbo_frame: "modal" }

= datagrid_form_for @grid, url: team_project_plants_path(@team, @project), html: { class: "mb-4" }

.card
  - if @grid.assets.any?
    .overflow-x-auto
      = datagrid_table(@grid, class: "data-table") do |grid|
        - grid.column(:actions, html: true) do |plant|
          .flex.gap-2.justify-end
            = link_to "View", team_project_plant_path(@team, @project, plant), class: "btn-sm btn-secondary"
            = link_to "Edit", edit_team_project_plant_path(@team, @project, plant), class: "btn-sm btn-secondary", data: { turbo_frame: "modal" }
            = link_to "Observe", new_team_project_plant_observation_path(@team, @project, plant), class: "btn-sm btn-primary"
    = render "shared/pagination", pagy: @pagy
  - else
    = render "shared/empty_state", title: "No plants yet", description: "Get started by adding your first plant to this project.", action_path: new_team_project_plant_path(@team, @project), action_text: "Add Plant"
