<tr id="<%= dom_id(plant) %>">
  <td>
    <%= link_to plant.identifier, edit_team_project_plant_path(@team, @project, plant),
        class: "text-green-600 hover:text-green-800 font-medium" %>
  </td>
  <td><%= plant.name.presence || "-" %></td>
  <td><%= plant.strain&.name || "-" %></td>
  <td><%= plant.source_type.titleize %></td>
  <td><%= plant.sex.titleize %></td>
  <td><%= stage_badge(plant.current_stage) %></td>
  <td><%= status_badge(plant.status) %></td>
  <td><%= plant.days_in_veg || "-" %></td>
  <td><%= plant.days_in_flower || "-" %></td>
  <td class="text-right">
    <%= link_to "Edit", edit_team_project_plant_path(@team, @project, plant),
        class: "btn-ghost btn-sm",
        data: { turbo_frame: "modal" } %>
    <%= button_to "Delete", team_project_plant_path(@team, @project, plant),
        method: :delete,
        class: "btn-ghost btn-sm text-red-600",
        form: { data: { turbo_confirm: "Delete this plant?" } } %>
  </td>
</tr>
