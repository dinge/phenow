<%= form_with url: team_project_plants_path(@team, @project), method: :get, class: "filter-bar",
    data: { controller: "filters", turbo_frame: "_top" } do |f| %>
  <div class="filter-grid">
    <div class="form-group">
      <%= f.label :q, "Search", class: "form-label" %>
      <%= f.text_field :q, value: params[:q], class: "form-input",
          placeholder: "Identifier, name, or notes...",
          data: { action: "input->filters#submit" } %>
    </div>

    <div class="form-group">
      <%= f.label :status, "Status", class: "form-label" %>
      <%= f.select :status,
          Plant::STATUSES.map { |s| [s.titleize, s] },
          { include_blank: "All statuses" },
          class: "form-select",
          data: { action: "change->filters#submit" } %>
    </div>

    <div class="form-group">
      <%= f.label :stage, "Stage", class: "form-label" %>
      <%= f.select :stage,
          Plant::STAGES.map { |s| [s.titleize.gsub("_", " "), s] },
          { include_blank: "All stages" },
          class: "form-select",
          data: { action: "change->filters#submit" } %>
    </div>

    <div class="form-group">
      <%= f.label :strain_id, "Strain", class: "form-label" %>
      <%= f.select :strain_id,
          @project.team.organization.strains.order(:name).map { |s| [s.name, s.id] },
          { include_blank: "All strains" },
          class: "form-select",
          data: { action: "change->filters#submit" } %>
    </div>
  </div>

  <div class="filter-actions">
    <%= link_to "Clear", team_project_plants_path(@team, @project), class: "btn-secondary" %>
  </div>
<% end %>
